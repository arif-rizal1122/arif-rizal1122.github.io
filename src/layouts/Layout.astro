---
import Navbar from '../components/Navbar';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
	noindex?: boolean;
	noFooter?: boolean;
}

const { title, noindex = false, noFooter = false } = Astro.props;
---

<!doctype html>
<html lang="id" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio Modern Arif Rizal - Backend Developer | Go Lang | Laravel | Java Spring" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <ViewTransitions />
    
    <!-- SEO -->
    <meta name="author" content="Arif Rizal" />
    <meta name="keywords" content="Arif Rizal, Backend Developer, Go Lang, Laravel, Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Portfolio Modern Arif Rizal - Backend Developer" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/img/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    
		<title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
	</head>
	<body class="bg-[#0f172a] text-[#f8fafc] transition-colors duration-500 antialiased selection:bg-blue-900/40 min-h-screen flex flex-col">
    <Navbar client:load />

		<main class="reveal flex-1">
			<slot />
		</main>

    {!noFooter && (
    <footer class="bg-[#0a1122] border-t border-white/5 py-12 md:py-16 mt-auto">
      <div class="container mx-auto px-4 md:px-6">
        <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-10 md:gap-16 mb-10">
          <!-- Brand -->
          <div class="text-center md:text-left max-w-sm">
            <a
              href="/"
              class="inline-block font-bold font-['Poppins'] bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent hover:scale-105 transition-transform text-xl md:text-2xl"
            >
              Arif Rizal
            </a>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">
              Backend Developer — Laravel, Go &amp; Java. Membangun solusi yang cepat, andal, dan scalable.
            </p>
          </div>

          <!-- Navigasi -->
          <nav class="text-center md:text-left">
            <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-4">Navigasi</h4>
            <div class="flex flex-wrap justify-center md:justify-start gap-x-8 gap-y-2.5">
              <a href="/#beranda" class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300 hover:text-blue-400 transition-colors">Beranda</a>
              <a href="/projects" class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300 hover:text-blue-400 transition-colors">Proyek</a>
              <a href="/blog" class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300 hover:text-blue-400 transition-colors">Blog</a>
              <a href="/dashboard" class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300 hover:text-blue-400 transition-colors">Dashboard</a>
              <a href="/contact" class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300 hover:text-blue-400 transition-colors">Kontak</a>
            </div>
          </nav>

          <!-- Sosial -->
          <div class="text-center md:text-right">
            <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-4">Sosial Media</h4>
            <div class="flex justify-center md:justify-end space-x-3">
              <a href="javascript:void(0)" aria-label="Facebook" class="w-10 h-10 rounded-xl bg-white/5 border border-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:bg-blue-600 hover:border-blue-600 transition-all"><i class="fab fa-facebook-f"></i></a>
              <a href="javascript:void(0)" aria-label="Instagram" class="w-10 h-10 rounded-xl bg-white/5 border border-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:bg-pink-600 hover:border-pink-600 transition-all"><i class="fab fa-instagram"></i></a>
              <a href="https://github.com/arif-rizal1122" aria-label="GitHub" target="_blank" class="w-10 h-10 rounded-xl bg-white/5 border border-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 hover:border-slate-700 transition-all"><i class="fab fa-github"></i></a>
              <a href="javascript:void(0)" aria-label="LinkedIn" class="w-10 h-10 rounded-xl bg-white/5 border border-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:bg-blue-700 hover:border-blue-700 transition-all"><i class="fab fa-linkedin-in"></i></a>
            </div>
          </div>
        </div>

        <!-- Copyright -->
        <div class="pt-6 border-t border-white/5 text-center">
          <p class="text-xs text-slate-500">&copy; 2024 Arif Rizal. Dibuat dengan <i class="fas fa-heart text-red-500"></i> dan Astro.</p>
        </div>
      </div>
    </footer>
    )}

	</body>
</html>

<style is:global>
  @import "tailwindcss";

	:root {
		--primary: #2563EB;
		--primary-dark: #1D4ED8;
		--primary-light: #3B82F6;
    --accent: #10B981;
    --background: #FFFFFF;
    --surface: #F9FAFB;
    --text-primary: #111827;
    --text-secondary: #6B7280;
    --transition: 500ms cubic-bezier(0.4, 0, 0.2, 1);
	}

  @theme {
    --color-blue-600: #2563EB;
    --color-emerald-500: #10B981;
  }

  html {
    font-family: 'Inter', system-ui, sans-serif;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    font-size: 16px;
    color: var(--text-primary);
    transition: background-color var(--transition), color var(--transition);
  }

  /* Task Widget Animations & Utilities */
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-slideDown {
    animation: slideDown 0.3s ease-out forwards;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 9999px;
  }
  .dark .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #334155;
  }

  /* Refined Dark Mode Palette (Slate/Navy) for Eye Comfort */
  .dark {
    --background: #0f172a; /* Slate 900 */
    --surface: #1e293b;    /* Slate 800 */
    --text-primary: #f8fafc;   /* Slate 50 */
    --text-secondary: #94a3b8; /* Slate 400 */
    color-scheme: dark;
  }

  body {
    background-color: var(--background);
    color: var(--text-primary);
    transition: background-color var(--transition), color var(--transition);
  }

  h1 { font-size: clamp(2rem, 8vw, 3.5rem); line-height: 1.1; font-weight: 700; font-family: 'Poppins', sans-serif; transition: color var(--transition); }
  h2 { font-size: clamp(1.5rem, 6vw, 2.5rem); line-height: 1.2; font-weight: 700; font-family: 'Poppins', sans-serif; transition: color var(--transition); }
  h3 { font-size: clamp(1.25rem, 4vw, 1.875rem); line-height: 1.3; font-weight: 600; font-family: 'Poppins', sans-serif; transition: color var(--transition); }
  h4 { font-size: clamp(1.1rem, 3vw, 1.5rem); line-height: 1.35; font-weight: 600; font-family: 'Poppins', sans-serif; transition: color var(--transition); }
  
  p { font-size: clamp(0.95rem, 2vw, 1.125rem); line-height: 1.6; color: var(--text-secondary); transition: color var(--transition); }

  /* Reveal Animation per context_frontend.md */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: #D1D5DB;
    border-radius: 9999px;
  }
  .dark ::-webkit-scrollbar-thumb {
    background: #374151;
  }

  /* Premium Utilities */
  @utility glass {
    background-color: rgb(255 255 255 / 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgb(255 255 255 / 0.2);
    transition: background-color var(--transition), border-color var(--transition);
  }

  .dark .glass {
    background-color: rgb(30 41 59 / 0.7); /* Adjusted for Slate 800 */
    border-color: rgb(51 65 85 / 0.3);      /* Adjusted for Slate 700 */
  }

  @utility text-gradient {
    background-image: linear-gradient(to right, #2563EB, #10B981);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @utility btn-primary {
    padding: 0.75rem 2rem;
    background-color: #2563EB;
    color: white;
    font-weight: 700;
    border-radius: 0.75rem;
    transition: all 0.2s;
    &:hover {
      background-color: #1D4ED8;
      box-shadow: 0 10px 15px -3px rgb(37 99 235 / 0.2);
    }
    &:active {
      scale: 0.95;
    }
  }

  @utility btn-secondary {
    padding: 0.75rem 2rem;
    background-color: white;
    color: #111827;
    font-weight: 700;
    border-radius: 0.75rem;
    border: 1px solid #E5E7EB;
    transition: all 0.2s;
    &:hover {
      background-color: #F9FAFB;
    }
    &:active {
      scale: 0.95;
    }
  }

  :dark @utility btn-secondary {
    background-color: #1F2937;
    color: white;
    border-color: #374151;
    &:hover {
      background-color: #374151;
    }
  }
</style>

<script>
  // Reveal animations on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, { threshold: 0.1 });

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  });

  // Fallback for non-ViewTransitions pages
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
